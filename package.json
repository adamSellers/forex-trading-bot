{
    "name": "forex-trading-bot",
    "version": "1.0.0",
    "description": "Forex trend-following trading bot",
    "private": true,
    "scripts": {
        "install:all": "cd backend && npm ci && cd ../frontend && npm ci",
        "install:backend": "cd backend && npm ci",
        "install:frontend": "cd frontend && npm ci",
        "build:frontend": "cd frontend && npm run build",
        "dev": "concurrently -n backend,frontend -c blue,green \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
        "start": "concurrently -n backend,frontend -c blue,green \"cd backend && npm start\" \"cd frontend && npm run preview\"",
        "dev:backend": "cd backend && npm run dev",
        "dev:frontend": "cd frontend && npm run dev",
        "build": "cd frontend && npm run build",
        "db:migrate": "cd backend && npm run db:migrate",
        "test:connection": "node scripts/testConnection.js"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "engines": {
        "node": ">=20 <23"
    }
}
