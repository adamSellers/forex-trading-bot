    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "socket.io": "^4.7.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "node-binance-api": "^0.13.1",
        "knex": "^2.5.1",
        "sqlite3": "^5.1.6"
    },
    "devDependencies": {
        "nodemon": "^3.0.1"
    },
    "engines": {
        "node": ">=16.0.0"
    }
