{
    "name": "crypto-trend-bot-backend",
    "version": "2.0.0",
    "description": "Cryptocurrency trend trading bot backend with paper trading",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "lint": "echo \"'lint' script not yet configured, but this is where it would go.\" && exit 0",
        "test": "npm run lint",
        "db:migrate": "knex migrate:latest",
        "db:rollback": "knex migrate:rollback",
        "backtest:fetch": "node scripts/fetch-historical-data.js",
        "backtest:run": "node scripts/run-backtest.js"
    },
    "keywords": [
        "cryptocurrency",
        "trading",
        "bot",
        "binance",
        "technical-analysis",
        "paper-trading"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.633.0",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^4.18.2",
        "knex": "^2.5.1",
        "node-binance-api": "^0.13.1",
        "socket.io": "^4.7.2",
        "sqlite3": "^5.1.6"
    },
    "devDependencies": {
        "nodemon": "^3.0.1"
    },
    "engines": {
        "node": ">=16.0.0"
    }
}
