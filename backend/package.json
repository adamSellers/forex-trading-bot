{
    "name": "crypto-trend-bot-backend",
    "version": "1.0.0",
    "description": "Cryptocurrency trend trading bot backend with paper trading",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "setup": "node scripts/setup-database.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "db:migrate": "knex migrate:latest",
        "db:seed": "knex seed:run",
        "db:rollback": "knex migrate:rollback"
    },
    "keywords": [
        "cryptocurrency",
        "trading",
        "bot",
        "binance",
        "technical-analysis",
        "paper-trading"
    ],
